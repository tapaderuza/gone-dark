{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "gone-dark-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_COMMENT",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    }
  },
  "menu": {
    "items": [
      {
        "label": "Gone Dark: post today's search",
        "description": "Creates today's daily post if it is not up yet",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scheduler": {
    "tasks": {
      "daily-post": {
        "endpoint": "/internal/scheduler/daily-post",
        "cron": "2 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "gone_dark_daily_dev"
  }
}